{
  "name": "numee-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk:debug": "expo prebuild --platform android && cd android && .\\gradlew.bat assembleDebug",
    "gradle:assembleDebug": "cd android && .\\gradlew.bat assembleDebug",
    "build:apk:eas": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eas-cli": "^18.5.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
